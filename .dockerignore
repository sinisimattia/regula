# Version control, editors, agent tooling — never needed inside an image.
.git
.gitattributes
.gitignore
.idea
.vscode
.claude
.mcp.json

# Dependencies are installed fresh in the vendor/dev stages, not copied from the host.
vendor
node_modules

# AWS CDK app — a separate deployable, not part of the PHP image.
cloud

# Test suite, docs and quality tooling — not needed at runtime.
tests
docs
insights
coverage
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache
.php-cs-fixer.cache
.php-cs-fixer.dist.php
phpinsights.php
CONTRIBUTING.md
README.md

# Local env files — the image is configured entirely via the container's own environment.
.env
.env.*

# Storage: keep the directory skeleton (and its .gitignore placeholders), drop everything
# generated locally — sessions, cached views/config, logs, uploaded files.
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/app/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore
!storage/app/.gitignore
!storage/app/public
storage/app/public/*
!storage/app/public/.gitignore

# Same story for bootstrap/cache: locally generated by composer/artisan, regenerated by
# `php artisan package:discover` in the production stage.
bootstrap/cache/*
!bootstrap/cache/.gitignore
